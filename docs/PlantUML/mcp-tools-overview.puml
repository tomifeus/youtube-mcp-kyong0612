@startuml MCP Tools Overview
!theme plain
title MCP Tools and Their Relationships

package "MCP Tools" {
  class GetTranscript {
    +video_identifier: string
    +languages: []string
    +preserve_formatting: boolean
    +include_metadata: boolean
    +include_timestamps: boolean
    --
    +Execute(): TranscriptResponse
  }

  class GetMultipleTranscripts {
    +video_identifiers: []string
    +languages: []string
    +preserve_formatting: boolean
    +include_metadata: boolean
    +include_timestamps: boolean
    +max_concurrent: int
    --
    +Execute(): MultipleTranscriptResponse
  }

  class TranslateTranscript {
    +transcript: TranscriptResponse
    +target_language: string
    +source_language: string
    +preserve_timestamps: boolean
    --
    +Execute(): TranscriptResponse
  }

  class FormatTranscript {
    +transcript: TranscriptResponse
    +format: string
    +options: map[string]any
    --
    +Execute(): string
  }

  class ListAvailableLanguages {
    +video_identifier: string
    --
    +Execute(): []LanguageInfo
  }
}

package "Data Models" {
  class TranscriptResponse {
    +VideoID: string
    +Title: string
    +Language: string
    +Transcript: []TranscriptSegment
    +Metadata: TranscriptMetadata
    +WordCount: int
    +CharCount: int
  }

  class MultipleTranscriptResponse {
    +Results: []TranscriptResult
    +TotalCount: int
    +SuccessCount: int
    +ErrorCount: int
    +ProcessingTime: time.Duration
  }

  class LanguageInfo {
    +Code: string
    +Name: string
    +IsAutoGenerated: boolean
    +IsTranslatable: boolean
  }

  class TranscriptSegment {
    +Text: string
    +Start: float64
    +Duration: float64
    +End: float64
  }
}

package "Format Types" {
  class FormatOptions {
    +plain_text: string
    +paragraphs: string
    +sentences: string
    +srt: string
    +vtt: string
    +json: string
  }
}

package "Dependencies" {
  class YouTubeService {
    +GetTranscript()
    +GetMultipleTranscripts()
    +TranslateTranscript()
    +FormatTranscript()
    +ListAvailableLanguages()
  }

  class Cache {
    +Get()
    +Set()
    +Delete()
  }
}

' Tool Relationships
GetTranscript --> YouTubeService : calls
GetMultipleTranscripts --> YouTubeService : calls
TranslateTranscript --> YouTubeService : calls
FormatTranscript --> YouTubeService : calls
ListAvailableLanguages --> YouTubeService : calls

' Data Flow
GetTranscript --> TranscriptResponse : returns
GetMultipleTranscripts --> MultipleTranscriptResponse : returns
TranslateTranscript --> TranscriptResponse : returns
FormatTranscript --> FormatOptions : returns
ListAvailableLanguages --> LanguageInfo : returns

' Dependencies
YouTubeService --> Cache : uses
YouTubeService --> TranscriptResponse : creates

' Format Relationships
FormatTranscript --> FormatOptions : supports
FormatOptions --> TranscriptResponse : formats

' Tool Capabilities
note top of GetTranscript
  Single video transcript fetching
  with language preferences and
  metadata inclusion options
end note

note top of GetMultipleTranscripts
  Batch processing up to 50 videos
  with concurrent execution and
  individual error handling
end note

note top of TranslateTranscript
  Translates existing transcript
  to target language with
  timestamp preservation
end note

note top of FormatTranscript
  Formats transcript to various
  formats: SRT, VTT, plain text,
  paragraphs, sentences, JSON
end note

note top of ListAvailableLanguages
  Lists all available subtitle
  languages for a video with
  auto-generated detection
end note

' Tool Configuration
note bottom of YouTubeService
  All tools use the same underlying
  YouTube service with shared
  rate limiting, caching, and
  proxy rotation
end note

@enduml
